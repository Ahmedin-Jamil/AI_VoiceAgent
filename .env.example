# LiveKit Server Configuration (Self-Hosted Sovereign)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Speech-to-Text (STT) Configuration
# Providers: faster-whisper | openai
STT_PROVIDER=faster-whisper
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ar

# LLM Brain & Dialogue Manager Configuration
# Providers: ollama | vllm | openai | allam
# For best Arabic quality → use allam (requires ALLAM_HF_API_KEY below)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.3

# ── ALLAM (Arabic LLM by SDAIA × IBM) — Hugging Face Inference API ──────────
# Switch LLM_PROVIDER=allam and paste your HF token below for best Arabic quality
# Get token: https://huggingface.co/settings/tokens
ALLAM_HF_API_KEY=

# Text-to-Speech (TTS) Configuration
# Providers: edge-tts | piper | openai
TTS_PROVIDER=edge-tts
# Authentic Saudi Voices: ar-SA-HamedNeural (Male) | ar-SA-ZariyahNeural (Female)
TTS_VOICE=ar-SA-HamedNeural

# Dialect Preset: najdi (Riyadh) | hijazi (Western) | fusha (Standard) | bilingual (AR/EN)
DEFAULT_DIALECT=najdi

# Telemetry and WebRTC Token API Server
API_HOST=0.0.0.0
API_PORT=8080
